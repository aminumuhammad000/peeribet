# Admin Portal Environment Configuration Example
# Copy to .env or .env.local to override default settings

# Base API URL (e.g. http://localhost:5000/api in local dev, or https://api.peeritrade.com/api in production)
VITE_API_URL=http://localhost:5000/api

# Vite Proxy Target (optional, used when VITE_API_URL is set to /api)
VITE_API_TARGET=http://localhost:5000
